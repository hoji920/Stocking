# 복사해서 .env 로 만들고 값 채우기 (.env 는 .gitignore 에 들어있음)

# 토스증권 WTS → 설정 → Open API 에서 발급. 허용 IP에 내 공인 IP 등록 필수(안 하면 403)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 국내 종목 뉴스: https://developers.naver.com 애플리케이션 등록 → 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 미국 종목 뉴스: https://finnhub.io 무료 키 (졸작 .env 에 있는 키 재사용 가능)
FINNHUB_API_KEY=

# 뉴스 요약 (없으면 요약 없이 기사 목록만 표시)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 지지/저항 알림
# 관심종목 현재가 확인 주기(초), 선까지 이 % 이내면 '근접' 알림
ALERT_POLL_SEC=60
ALERT_NEAR_PCT=1.0
# 전일 종가 대비 이만큼(%) 움직이면 '급등락' 알림 + 뉴스로 이유 찾기 (3 → 3%, 6%, 9% 단계마다)
ALERT_MOVE_PCT=3.0
# 집 와이파이의 노트북·폰에서 볼 때 비밀번호 (.\run.ps1 -Lan). 이 PC 에서는 안 물어봄
APP_PASSWORD=

# (선택) 창 닫아도 폰으로 받기: @BotFather 로 봇 만들고, 봇에게 말 건 뒤 chat_id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
